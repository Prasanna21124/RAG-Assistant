# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Custom API Secret Key for securing your FastAPI endpoints
API_SECRET_KEY=your_secure_api_secret_key_here

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/rag_db
